---
import { withBase } from "../lib/url.js";

interface Props {
  /** Nombre del juego: da el alt de la imagen y el aria-label de los botones */
  title: string;
  image: { src: string; alt?: string };
  playHref: string;
  sheetHref: string;
}

const { title, image, playHref, sheetHref } = Astro.props as Props;

// Defensa en profundidad: aunque el esquema ya lo valida, nunca pintamos un
// href con un esquema no permitido (p. ej. javascript:).
const safeHref = (href: string) => (/^(\/|#|https?:\/\/|mailto:|tel:)/i.test(href) ? href : "#");
---

<article class="card-portrait">
  <img class="cover" src={withBase(image.src)} alt={image.alt || title} />
  <div class="overlay" aria-hidden="true"></div>
  <span class="hint" aria-hidden="true">
    <img src={withBase("/images/icon-play.svg")} alt="" />
  </span>
  <div class="actions">
    <a class="btn" data-type="primary" href={safeHref(playHref)} aria-label={`Play demo – ${title}`}>Play Demo</a>
    <a class="btn" data-type="secondary" href={safeHref(sheetHref)} aria-label={`Game sheet – ${title}`}>Game sheet</a>
  </div>
</article>

<style>
  .card-portrait {
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
    --ease-in: cubic-bezier(0.4, 0, 1, 1);
    --dur-in: 450ms;
    --dur-out: 180ms;
    --stagger: 60ms;
    position: relative;
    aspect-ratio: 3 / 4;
    width: 100%;
    overflow: hidden;
    isolation: isolate;
    container-type: inline-size;
    border: var(--border-br-1) solid var(--opacity-white-opc-25);
    border-radius: var(--radius-rd-16);
    transition: border-color var(--dur-out) var(--ease-in);
  }
  .cover {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-out) var(--ease-in), filter var(--dur-out) var(--ease-in);
  }
  .overlay {
    display: none;
    position: absolute;
    inset: 0;
    background: var(--opacity-black-opc-80);
    opacity: 0;
    transition: opacity var(--dur-out) var(--ease-in);
  }
  .hint {
    display: none;
    position: absolute;
    right: var(--gap-gap-16);
    bottom: var(--gap-gap-16);
    align-items: center;
    justify-content: center;
    width: var(--size-sp-40);
    height: var(--size-sp-40);
    border: var(--border-br-1) solid var(--opacity-white-opc-25);
    border-radius: var(--radius-rd-200);
    background: var(--opacity-black-opc-60);
    backdrop-filter: blur(8px);
    transition: opacity 150ms var(--ease-out), scale 150ms var(--ease-out);
  }
  .hint img {
    width: 20px;
    height: 20px;
  }
  .actions {
    position: absolute;
    display: flex;
  }
  .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--radius-rd-8);
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    background: var(--buttons-fill-primary-default);
    color: var(--buttons-text-primary-default);
    transition: transform 160ms var(--ease-out), filter 160ms var(--ease-out);
  }
  .btn[data-type="secondary"] {
    background: var(--buttons-fill-secondary-default);
    color: var(--buttons-text-secondary-default);
  }
  .btn:hover {
    filter: brightness(1.08);
    transform: translateY(-2px);
  }
  .btn:active {
    transform: scale(0.96);
  }
  .btn:focus-visible {
    outline: 3px solid var(--buttons-fill-secondary-default);
    outline-offset: 3px;
  }

  /* Touch (por defecto): botones siempre visibles sobre un degradado */
  .actions {
    inset: auto 0 0 0;
    gap: var(--gap-gap-16);
    padding: var(--gap-gap-32) var(--gap-gap-16) var(--gap-gap-16);
    background: linear-gradient(
      to bottom,
      var(--overlay-scrim-start) 0%,
      var(--overlay-scrim-mid) 45%,
      var(--overlay-scrim-end) 100%
    );
  }
  .actions .btn {
    flex: 1 1 0;
    min-width: 0;
    height: 46px;
    padding: var(--gap-gap-12) var(--gap-gap-16);
    font-size: var(--font-size-body-m);
  }

  /* Touch compact: card estrecha, botones apilados */
  @container (max-width: 200px) {
    .actions {
      flex-direction: column;
      gap: var(--gap-gap-8);
      padding: var(--gap-gap-16) var(--gap-gap-8) var(--gap-gap-8);
    }
    .actions .btn {
      flex: none;
      width: 100%;
      padding: var(--gap-gap-12);
      font-size: var(--font-size-body-m);
    }
  }

  /* Pointer: botones aparecen al pasar el ratón o con foco de teclado */
  @media (hover: hover) and (pointer: fine) {
    .overlay {
      display: block;
    }
    .hint {
      display: flex;
    }
    .actions {
      inset: 50% auto auto 50%;
      flex-direction: column;
      gap: var(--gap-gap-12);
      width: min(230px, calc(100% - 48px));
      padding: 0;
      background: none;
      transform: translate(-50%, -50%);
    }
    .actions .btn {
      flex: none;
      width: 100%;
      height: 56px;
      padding: var(--gap-gap-16) var(--gap-gap-24);
      font-size: var(--font-size-body-l);
      opacity: 0;
      translate: 0 24px;
      scale: 0.94;
      transition:
        opacity var(--dur-out) var(--ease-in),
        translate var(--dur-out) var(--ease-in),
        scale var(--dur-out) var(--ease-in),
        transform 160ms var(--ease-out),
        filter 160ms var(--ease-out);
    }
    .actions .btn + .btn {
      translate: 0 48px;
    }

    .card-portrait:is(:hover, :focus-within) .cover {
      transform: scale(1.08);
      filter: blur(4px);
      transition: transform 500ms var(--ease-out), filter 500ms var(--ease-out);
    }
    .card-portrait:is(:hover, :focus-within) .hint {
      opacity: 0;
      scale: 0.6;
    }
    .card-portrait:is(:hover, :focus-within) .overlay {
      opacity: 1;
      transition: opacity 250ms var(--ease-out);
    }
    .card-portrait:is(:hover, :focus-within) .actions .btn {
      opacity: 1;
      translate: 0 0;
      scale: 1;
      transition:
        opacity 220ms var(--ease-out) var(--d),
        translate var(--dur-in) var(--ease-spring) var(--d),
        scale var(--dur-in) var(--ease-spring) var(--d),
        transform 160ms var(--ease-out),
        filter 160ms var(--ease-out);
    }
    .actions .btn:nth-child(1) {
      --d: 80ms;
    }
    .actions .btn:nth-child(2) {
      --d: calc(80ms + var(--stagger));
    }
  }
  .card-portrait:focus-within {
    border-color: var(--buttons-fill-secondary-default);
  }

  @media (prefers-reduced-motion: reduce) {
    .card-portrait,
    .card-portrait * {
      transition-duration: 120ms !important;
      transition-delay: 0ms !important;
    }
    .card-portrait .cover {
      transform: none !important;
      filter: none !important;
    }
    .card-portrait .hint {
      scale: 1 !important;
    }
    .card-portrait .actions .btn {
      translate: 0 0 !important;
      scale: 1 !important;
    }
  }
</style>
