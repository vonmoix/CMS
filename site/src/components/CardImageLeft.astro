---
import { withBase } from "../lib/url.js";

interface Props {
  title: string;
  /** Fragmento del título que se resalta en rojo */
  highlight?: string;
  content: string;
  image?: { src: string; alt?: string };
  showImage?: boolean;
}

const { title, highlight, content, image, showImage = true } = Astro.props as Props;
const at = highlight ? title.indexOf(highlight) : -1;
const before = at >= 0 ? title.slice(0, at) : title;
const marked = at >= 0 ? highlight : "";
const after = at >= 0 ? title.slice(at + highlight!.length) : "";
const hasImage = showImage && image?.src;
---

<article class="card card-image-left" data-image={hasImage ? "true" : "false"}>
  <div class="info">
    <div class="header">
      <h2>{before}{marked && <span class="accent">{marked}</span>}{after}</h2>
    </div>
    <p class="body">{content}</p>
  </div>
  {hasImage && <img src={withBase(image!.src)} alt={image!.alt || ""} />}
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 var(--gap-gap-24);
  }
  .card[data-image="true"] {
    padding-top: var(--gap-gap-256);
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: var(--gap-gap-24);
    width: 100%;
    padding: var(--gap-gap-64) var(--size-sp-40) var(--size-sp-40);
    background: var(--fill-surface-black);
    border-radius: var(--radius-rd-16);
  }
  .header {
    display: flex;
    flex-direction: column;
    gap: var(--gap-gap-8);
  }
  h2 {
    margin: 0;
    font-size: var(--font-size-display-xl);
    line-height: var(--line-height-display-xl);
    color: var(--text-primary);
  }
  .accent {
    color: var(--fill-surface-red);
  }
  .body {
    margin: 0;
    white-space: pre-line;
    font-size: var(--font-size-body-m);
    line-height: var(--line-height-body-m);
    color: var(--text-primary);
  }
  /* Mobile: mascota centrada sobre la tarjeta */
  img {
    position: absolute;
    top: 0;
    left: 50%;
    width: 220px;
    height: 308px;
    transform: translateX(-50%);
    object-fit: cover;
  }
  /* Desktop: imagen a la izquierda, texto a la derecha */
  @media (min-width: 1024px) {
    .card,
    .card[data-image="true"] {
      min-height: 436px;
      padding: 0;
    }
    .info {
      align-self: stretch;
      justify-content: center;
      padding: var(--size-sp-48);
    }
    .card[data-image="true"] .info {
      padding-left: 370px;
    }
    img {
      top: auto;
      bottom: 0;
      left: var(--gap-gap-24);
      width: 288px;
      height: 403px;
      transform: none;
    }
  }
</style>
