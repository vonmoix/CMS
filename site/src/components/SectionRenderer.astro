---
// Traduce cada objeto "sección" del JSON al componente que lo renderiza.
// Añadir un tipo de sección nuevo = añadir una línea aquí + el componente
// en ./sections/ + la definición en src/content/config.ts.
import Hero from "./sections/Hero.astro";
import SectionVideo from "./sections/SectionVideo.astro";
import TextImage from "./sections/TextImage.astro";
import Cta from "./sections/Cta.astro";
import Gallery from "./sections/Gallery.astro";
import GamesGroup from "./sections/GamesGroup.astro";
import SectionGames from "./sections/SectionGames.astro";
import SectionImageCard from "./sections/SectionImageCard.astro";
import SectionMascot from "./sections/SectionMascot.astro";
import Carousel from "./sections/Carousel.astro";
import Faq from "./sections/Faq.astro";
import IntroText from "./sections/IntroText.astro";

const componentsByType = {
  hero: Hero,
  sectionVideo: SectionVideo,
  textImage: TextImage,
  cta: Cta,
  gallery: Gallery,
  gamesGroup: GamesGroup,
  sectionImageCard: SectionImageCard,
  sectionMascot: SectionMascot,
  carousel: Carousel,
  faq: Faq,
  introText: IntroText,
  // "Title": IntroText sin texto (title-hero o title-section según size)
  titleHero: IntroText,
};

// Tipos que van a sangre, fuera de las franjas de color.
const fullBleed = new Set(["sectionVideo", "sectionImageCard", "sectionMascot"]);
// Franjas de intro: si solo llevan estos tipos, padding 48 (como en Figma y en
// la landing, .section-content--intro); el resto de franjas, 32.
const introTypes = new Set(["introText", "titleHero"]);

const { sections = [] } = Astro.props;

// Estructura resultante:
//   div.section-content[data-surface]  → fondo a ancho completo
//     div.wrapper           → ancho máximo y padding lateral
//       section.block.<tipo>  (sin fondo propio)
// Las secciones consecutivas con el mismo "surface" comparten franja.
const groups = [];
for (const section of sections) {
  if (!componentsByType[section.type]) continue;
  if (fullBleed.has(section.type)) {
    groups.push({ bleed: true, items: [section] });
    continue;
  }
  // Los games-group consecutivos van juntos en una sola section-games (a sangre)
  if (section.type === "gamesGroup") {
    const last = groups[groups.length - 1];
    if (last && last.games) last.items.push(section);
    else groups.push({ games: true, items: [section] });
    continue;
  }
  const surface = section.surface ?? "grey-medium";
  const last = groups[groups.length - 1];
  if (last && !last.bleed && last.surface === surface) {
    last.items.push(section);
  } else {
    groups.push({ surface, items: [section] });
  }
}
---

{
  groups.map((group) => {
    if (group.games) {
      return (
        <SectionGames>
          {group.items.map((section) => <GamesGroup {...section} />)}
        </SectionGames>
      );
    }
    if (group.bleed) {
      const Component = componentsByType[group.items[0].type];
      return <Component {...group.items[0]} />;
    }
    return (
      <div
        class:list={["section-content", { "section-content--intro": group.items.every((section) => introTypes.has(section.type)) }]}
        data-surface={group.surface}
      >
        <div class="wrapper">
          {group.items.map((section) => {
            const Component = componentsByType[section.type];
            return <Component {...section} />;
          })}
        </div>
      </div>
    );
  })
}
