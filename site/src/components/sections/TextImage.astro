---
import { withBase } from "../../lib/url.js";
const { title, copy, image, imagePosition = "right" } = Astro.props;
---

<section class="block text-image" data-position={imagePosition}>
  <div class="grid">
    <div class="text">
      <h2>{title}</h2>
      <p>{copy}</p>
    </div>
    {image?.src && (
      <div class="image">
        <img src={withBase(image.src)} alt={image.alt || ""} />
      </div>
    )}
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: var(--gap-gap-32);
    align-items: center;
  }
  h2 {
    margin: 0 0 var(--gap-gap-24);
    font-size: var(--font-size-heading-l);
    line-height: var(--line-height-heading-l);
  }
  p {
    margin: 0;
    color: var(--band-fg);
    font-size: var(--font-size-body-l);
    line-height: var(--line-height-body-l);
    white-space: pre-line;
  }
  .image img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    background: var(--fill-surface-white);
    border: var(--border-br-1) solid var(--opacity-white-opc-10);
    border-radius: var(--radius-rd-8);
  }
  @media (min-width: 700px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .image img {
      height: auto;
      aspect-ratio: 378.5 / 262;
    }
    .text-image[data-position="left"] .grid {
      direction: rtl;
    }
    .text-image[data-position="left"] .grid > * {
      direction: ltr;
    }
  }
</style>
