---
import { withBase } from "../../lib/url.js";
const { heading, body, image, imagePosition = "right" } = Astro.props;
---

<section class="block text-image" data-position={imagePosition}>
  <div class="grid">
    <div class="text">
      <h2>{heading}</h2>
      <p>{body}</p>
    </div>
    {image?.src && (
      <div class="image">
        <img src={withBase(image.src)} alt={image.alt || ""} />
      </div>
    )}
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: var(--gap-gap-32);
    align-items: center;
  }
  h2 {
    margin-top: 0;
  }
  p {
    margin: 0;
    color: var(--band-fg);
    font-size: var(--font-size-body-s);
    line-height: var(--line-height-body-s);
    font-weight: 600;
    white-space: pre-line;
  }
  .image img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    background: var(--fill-surface-grey-dark);
  }
  @media (min-width: 700px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .image img {
      height: auto;
      aspect-ratio: 346.5 / 240;
    }
    .text-image[data-position="left"] .grid {
      direction: rtl;
    }
    .text-image[data-position="left"] .grid > * {
      direction: ltr;
    }
  }
</style>
