---
import { withBase } from "../../lib/url.js";
const { eyebrow, title, copy, image, button, imagePosition = "right" } = Astro.props;
---

<section class="block hero" data-position={imagePosition}>
  <div class="hero-grid">
    <div class="text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {copy && <p class="copy">{copy}</p>}
      {button?.href && (
        <a class="btn" href={withBase(button.href)}>
          {button.label}
        </a>
      )}
    </div>
    {image?.src && <img src={withBase(image.src)} alt={image.alt || ""} />}
  </div>
</section>

<style>
  .hero-grid {
    display: grid;
    gap: var(--gap-gap-32);
    align-items: center;
    padding-block: var(--gap-gap-48);
  }
  .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-gap-24);
  }
  .eyebrow {
    color: var(--text-tertiary);
    font-size: var(--font-size-body-xl);
    line-height: var(--line-height-body-xl);
    font-weight: 600;
    margin: 0 0 calc(var(--gap-gap-8) * -1);
  }
  h1 {
    font-size: var(--font-size-heading-l);
    line-height: var(--line-height-heading-l);
    text-transform: uppercase;
    margin: 0;
  }
  .copy {
    color: var(--band-fg);
    font-size: var(--font-size-body-l);
    line-height: var(--line-height-body-l);
    margin: 0;
  }
  img {
    width: 100%;
    aspect-ratio: 379.5 / 262.7;
    object-fit: cover;
    background: var(--fill-surface-white);
    border: var(--border-br-1) solid var(--opacity-white-opc-10);
    border-radius: var(--radius-rd-8);
  }
  @media (min-width: 700px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
    }
    .hero[data-position="left"] .hero-grid {
      direction: rtl;
    }
    .hero[data-position="left"] .hero-grid > * {
      direction: ltr;
    }
    /* Botón tamaño M en Desktop/Tablet (en Mobile queda el S por defecto) */
    .btn {
      height: 46px;
      padding: var(--gap-gap-12) var(--gap-gap-48);
      font-size: var(--font-size-body-m);
    }
  }
</style>
