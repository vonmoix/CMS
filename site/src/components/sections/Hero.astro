---
import { withBase } from "../../lib/url.js";
const { eyebrow, heading, subheading, image, button } = Astro.props;
---

<section class="block hero">
  <div class="hero-grid">
    <div class="text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{heading}</h1>
      {subheading && <p class="subheading">{subheading}</p>}
      {button?.href && (
        <a class="btn" href={withBase(button.href)}>
          {button.label}
        </a>
      )}
    </div>
    {image?.src && <img src={withBase(image.src)} alt={image.alt || ""} />}
  </div>
</section>

<style>
  .hero-grid {
    display: grid;
    gap: var(--gap-gap-48);
    align-items: center;
  }
  .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-gap-16);
  }
  .eyebrow {
    text-transform: uppercase;
    font-size: var(--font-size-body-s);
    line-height: var(--line-height-body-s);
    font-weight: 700;
    color: var(--color-accent);
    margin: 0;
  }
  h1 {
    font-size: var(--font-size-heading-m);
    line-height: var(--line-height-heading-m);
    margin: 0;
  }
  .subheading {
    color: var(--text-primary);
    font-size: var(--font-size-body-l);
    line-height: var(--line-height-body-l);
    margin: 0;
  }
  img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-rd-16);
  }
  @media (min-width: 700px) {
    .hero-grid {
      grid-template-columns: 1fr minmax(0, 520px);
    }
    /* Botón tamaño M en Desktop/Tablet (en Mobile queda el S por defecto) */
    .btn {
      height: 46px;
      padding: var(--gap-gap-12) var(--gap-gap-48);
      font-size: var(--font-size-body-m);
    }
  }
</style>
