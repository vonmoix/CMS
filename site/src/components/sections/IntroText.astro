---
// Figma header-hero (size "xl") y header-section (size "l"): título + descripción,
// centrados. Mismo marcado, clases y valores que la landing (.title-hero /
// .section-title) y que Figma Playzaar-Webs-1.0:
//   header-hero    (5108:1176): title-hero  + Description Body/XL (máx. 800), hueco 32, máx. 1200
//   header-section (3459:4347): title-section + Description Body/XL,           hueco 32, máx. 900
// También pinta el tipo "titleHero" (componente "Title" del CMS): mismo
// marcado sin descripción → title-hero (3178:10676) o title-section (3124:8606).
// No es un section.block: no lleva padding propio. El padding vertical lo pone
// la franja (.section-content, 48 cuando solo lleva intros) y el color la
// superficie (--band-fg / --band-fg-muted).
import { splitHighlight } from "../../lib/highlight.js";

interface Props {
  eyebrow?: string;
  title?: string;
  /** Parte del título que va en rojo (.text--primary) */
  highlight?: string;
  copy?: string;
  size?: "xl" | "l";
  /** Etiqueta del título: h1 solo en el primer título de la página (lo decide SectionRenderer) */
  as?: "h1" | "h2";
}

const { eyebrow, title, highlight, copy, size = "xl", as: Heading = "h2" } = Astro.props as Props;
const [before, marked, after] = splitHighlight(title ?? "", highlight);
const hero = size === "xl";
const hasHeader = eyebrow || title;
---

<section class={hero ? "header-hero" : "header-section"}>
  {hasHeader && (
    hero ? (
      <div class="title-hero">
        <div class="title-hero__copy">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          {title && <Heading class="title-hero__heading">{before}{marked && <span class="text--primary">{marked}</span>}{after}</Heading>}
        </div>
        <span class="title-hero__underline" aria-hidden="true"></span>
      </div>
    ) : (
      <div class="section-title">
        <div class="section-title__copy">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          {title && <Heading class="section-title__heading">{before}{marked && <span class="text--primary">{marked}</span>}{after}</Heading>}
        </div>
        <span class="section-title__underline" aria-hidden="true"></span>
      </div>
    )
  )}
  {copy && <p class="description">{copy}</p>}
</section>

<style>
  .header-hero,
  .header-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-gap-32);
    width: 100%;
    margin: 0 auto;
    text-align: center;
  }
  .header-hero { max-width: 1200px; }
  .header-section { max-width: 900px; }

  .title-hero,
  .section-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-gap-16);
    width: 100%;
  }
  .title-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    width: 100%;
  }
  .section-title__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-gap-8);
    width: 100%;
  }

  .eyebrow {
    margin: 0;
    font: var(--text-body-l-semibold);
    text-transform: uppercase;
    color: var(--band-fg-muted);
  }
  .title-hero__heading,
  .section-title__heading {
    margin: 0;
    text-transform: uppercase;
    color: var(--band-fg);
  }
  .title-hero__heading { font: var(--text-display-2xl); }
  .section-title__heading { font: var(--text-display-xl); }

  .text--primary {
    color: var(--text-accent);
  }

  .title-hero__underline,
  .section-title__underline {
    flex-shrink: 0;
    width: var(--spacing-sp-48);
    height: 2px;
    background: var(--fill-surface-red);
  }

  .description {
    margin: 0;
    width: 100%;
    white-space: pre-line;
    font: var(--text-body-xl);
    color: var(--band-fg);
  }
  .header-hero .description { max-width: 800px; }
</style>
