---
const { eyebrow, heading, description } = Astro.props;
---

<section class="block intro-dark">
  <div class="intro-box">
    <div class="title-section">
      <div class="copy">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h2>{heading}</h2>
      </div>
      <span class="underline" aria-hidden="true"></span>
    </div>
    {description && <p class="description">{description}</p>}
  </div>
</section>

<style>
  .intro-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-gap-32);
    max-width: var(--layout-content-6col);
    margin: 0 auto;
    padding: var(--gap-gap-64);
    background: var(--fill-page-grey-medium);
    border-radius: var(--radius-rd-sm);
    text-align: center;
  }
  .title-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-gap-16);
    width: 100%;
  }
  .copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-none);
    width: 100%;
  }
  .eyebrow {
    margin: 0;
    text-transform: uppercase;
    font-weight: 600;
    font-size: var(--font-size-body-m);
    line-height: var(--line-height-body-m);
    color: var(--text-tertiary);
  }
  h2 {
    margin: 0;
    text-transform: uppercase;
    font-size: var(--font-size-display-xl);
    line-height: var(--line-height-display-xl);
    color: var(--text-primary);
  }
  .underline {
    width: var(--size-sp-48);
    height: var(--size-sp-2);
    background: var(--fill-surface-red);
  }
  .description {
    margin: 0;
    width: 100%;
    max-width: var(--layout-content-6col);
    white-space: pre-line;
    font-size: var(--font-size-body-xl);
    line-height: var(--line-height-body-xl);
    color: var(--text-primary);
  }
</style>
