---
const { heading, body } = Astro.props;
---

<section class="block rich-text">
  {heading && <h2>{heading}</h2>}
  <p>{body}</p>
</section>

<style>
  p {
    margin: 0;
    white-space: pre-line;
    max-width: 600px;
    font-size: var(--font-size-body-xl);
    line-height: var(--line-height-body-xl);
    color: var(--text-primary);
  }
</style>
