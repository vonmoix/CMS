---
const { eyebrow, heading, description } = Astro.props;
---

<section class="block intro-white">
  <div class="intro-box">
    <div class="content">
      <div class="title-section">
        <div class="copy">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          <h2>{heading}</h2>
        </div>
        <span class="underline" aria-hidden="true"></span>
      </div>
      {description && <p class="description">{description}</p>}
    </div>
  </div>
</section>

<style>
  .intro-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--gap-gap-40);
    padding: var(--gap-gap-128) var(--gap-gap-64);
    background: var(--fill-surface-white);
    text-align: center;
  }
  .content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--gap-gap-48);
    width: 100%;
    max-width: var(--layout-content-6col);
  }
  .title-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-gap-16);
    width: 100%;
  }
  .copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--gap-none);
    width: 100%;
  }
  .eyebrow {
    margin: 0;
    text-transform: uppercase;
    font-weight: 600;
    font-size: var(--font-size-body-l);
    line-height: var(--line-height-body-l);
    color: var(--text-secondary);
  }
  h2 {
    margin: 0;
    text-transform: uppercase;
    font-size: var(--font-size-display-xl);
    line-height: var(--line-height-display-xl);
    color: var(--text-secondary);
  }
  .underline {
    width: var(--size-sp-48);
    height: var(--size-sp-2);
    background: var(--fill-surface-red);
  }
  .description {
    margin: 0;
    width: 100%;
    white-space: pre-line;
    font-size: var(--font-size-body-xl);
    line-height: var(--line-height-body-xl);
    color: var(--text-secondary);
  }
  /* Tablet: gap 48 y contenido máx. 700px */
  @media (min-width: 768px) {
    .intro-box {
      gap: var(--gap-gap-48);
    }
    .content {
      max-width: 700px;
    }
  }
  /* Desktop: padding 128 en todos los lados y contenido máx. 1200px */
  @media (min-width: 1024px) {
    .intro-box {
      padding: var(--gap-gap-128);
    }
    .content {
      max-width: var(--layout-content-6col);
    }
  }
</style>
