---
import { withBase } from "../../lib/url.js";
const { heading, images = [] } = Astro.props;
---

<section class="block gallery">
  {heading && <h2>{heading}</h2>}
  <div class="grid">
    {images.map((img) => (
      <figure>
        <img src={withBase(img.src)} alt={img.alt || ""} />
      </figure>
    ))}
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--size-sp-220), 1fr));
    gap: var(--gap-gap-16);
  }
  figure {
    margin: 0;
  }
  figure img {
    border-radius: var(--radius-rd-8);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
  }
</style>
