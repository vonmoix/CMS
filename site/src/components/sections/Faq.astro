---
const { heading, items = [] } = Astro.props;
---

<section class="block faq">
  {heading && <h2>{heading}</h2>}
  <div class="items">
    {items.map((item) => (
      <details>
        <summary>{item.question}</summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </div>
</section>

<style>
  details {
    border-bottom: 1px solid var(--color-border);
    padding: 1rem 0;
  }
  summary {
    cursor: pointer;
    font-weight: 600;
  }
  details p {
    color: var(--color-muted);
    margin: 0.75rem 0 0;
  }
</style>
