---
const { heading, items = [] } = Astro.props;
---

<section class="block faq">
  {heading && <h2>{heading}</h2>}
  <div class="items">
    {items.map((item) => (
      <details>
        <summary>{item.question}</summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </div>
</section>

<style>
  details {
    border-bottom: var(--border-br-1) solid var(--stroke-br-100);
    padding: var(--gap-gap-16) 0;
  }
  summary {
    display: flex;
    align-items: center;
    gap: var(--gap-gap-8);
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    font-size: var(--font-size-body-xl);
    line-height: var(--line-height-body-xl);
    color: var(--text-primary);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* ▼ girado -90° = ▶ (cerrado); abierto = ▼ */
  summary::before {
    content: "▼";
    flex: none;
    width: 16px;
    font-size: 12px;
    line-height: 1;
    text-align: center;
    transform: rotate(-90deg);
  }
  details[open] summary {
    gap: 13px;
  }
  details[open] summary::before {
    width: auto;
    transform: none;
  }
  details p {
    color: var(--text-tertiary);
    font-size: var(--font-size-body-l);
    line-height: var(--line-height-body-l);
    margin: 12px 0 0;
  }
</style>
