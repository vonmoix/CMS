---
import { withBase } from "../lib/url.js";

interface Props {
  /** Nombre del juego: da el alt de la imagen y el aria-label de los botones */
  title: string;
  image: { src: string; alt?: string };
  playHref: string;
  sheetHref: string;
  /** Feature hit rate (p. ej. "1 in 325"). Opcional: solo se ve en el reverso (Pointer) */
  hitRate?: string;
  /** RTP del juego (p. ej. "96%"). Opcional: solo se ve en el reverso (Pointer) */
  rtp?: string;
}

const { title, image, playHref, sheetHref, hitRate, rtp } = Astro.props as Props;

// Defensa en profundidad: aunque el esquema ya lo valida, nunca pintamos un
// href con un esquema no permitido (p. ej. javascript:).
const safeHref = (href: string) => (/^(\/|#|https?:\/\/|mailto:|tel:)/i.test(href) ? href : "#");
const resolve = (href: string) => withBase(safeHref(href));
// La demo (externa) y la ficha (PDF) se abren en una pestaña nueva
const opensNew = (href: string) => /^https?:\/\//i.test(href) || /\.pdf($|[?#])/i.test(href);
const newTab = (href: string) => (opensNew(href) ? { target: "_blank", rel: "noopener" } : {});
---

<article class="card-pt">
  <div class="flip">
    <div class="face front">
      <img class="cover" src={withBase(image.src)} alt={image.alt || title} />
      {rtp && <p class="rtp-chip"><span class="stat-label">RTP</span> {rtp}</p>}
    </div>
    <div class="face back">
      <img class="cover back-cover" src={withBase(image.src)} alt="" aria-hidden="true" />
      <div class="info">
        <p class="name">{title}</p>
        {hitRate && <p class="stat"><span class="stat-label">Feature hit rate</span> {hitRate}</p>}
        {rtp && <p class="stat"><span class="stat-label">RTP</span> {rtp}</p>}
      </div>
      <div class="actions">
        <a class="btn" data-type="primary" href={resolve(playHref)} {...newTab(playHref)} aria-label={`Play – ${title} (demo)`}>Play</a>
        <a class="btn" data-type="secondary" href={resolve(sheetHref)} {...newTab(sheetHref)} aria-label={`Info – ${title} (game sheet)`}>Info</a>
      </div>
    </div>
  </div>
</article>

<style>
  /* Figma card-pt (5172:90).
     Touch (por defecto): portada con los dos botones en una franja inferior.
     Pointer: la carta gira en 3D al pasar el ratón o con foco de teclado
     (idea del CodePen "Flip Cards Responsive" de josetxu): delante la portada;
     detrás la portada bajo negro al 80 %, el nombre, feature hit rate, RTP y los botones. */
  .card-pt {
    --ease-in: cubic-bezier(0.4, 0, 1, 1);
    --dur-flip: 400ms;
    position: relative;
    aspect-ratio: 3 / 4;
    width: 100%;
    container-type: inline-size;
  }

  /* Caras: llevan el borde y el radio de la carta */
  .face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border: var(--border-br-1) solid var(--opacity-white-opc-25);
    border-radius: var(--radius-rd-md);
    transition: border-color 180ms var(--ease-in);
  }
  .card-pt:focus-within .face {
    border-color: var(--buttons-secondary-default);
  }
  .cover {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Touch: RTP en un chip arriba a la derecha (Figma rtp-chip). En Pointer se oculta: el RTP va en el reverso */
  .rtp-chip {
    position: absolute;
    top: var(--gap-gap-16);
    right: var(--gap-gap-16);
    display: flex;
    align-items: center;
    gap: var(--gap-gap-4);
    margin: 0;
    padding: var(--gap-gap-4) 10px;
    border: var(--border-br-1) solid var(--opacity-white-opc-25);
    border-radius: var(--radius-rd-full);
    background: var(--opacity-black-opc-60);
    font: var(--text-body-s-semibold);
    color: var(--text-primary);
    white-space: nowrap;
  }
  .rtp-chip .stat-label {
    color: var(--text-tertiary);
  }

  /* Touch: el reverso no existe como cara; solo se ve la franja de botones sobre la portada */
  .back {
    border: 0;
    border-radius: 0 0 var(--radius-rd-md) var(--radius-rd-md);
    inset: auto 0 0 0;
  }
  .back-cover,
  .info {
    display: none;
  }

  .actions {
    position: relative;
    display: flex;
  }
  .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--radius-rd-sm);
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    background: var(--buttons-primary-default);
    color: var(--text-buttons-primary-default);
    transition: transform 160ms var(--ease-out), filter 160ms var(--ease-out);
  }
  .btn[data-type="secondary"] {
    background: var(--buttons-secondary-default);
    color: var(--text-buttons-secondary-default);
  }
  .btn:hover {
    filter: brightness(1.08);
    transform: translateY(-2px);
  }
  .btn:active {
    transform: scale(0.96);
  }
  .btn:focus-visible {
    outline: 3px solid var(--buttons-secondary-default);
    outline-offset: 3px;
  }

  /* Touch (por defecto): botones siempre visibles sobre un degradado */
  .actions {
    gap: var(--gap-gap-16);
    padding: var(--gap-gap-32) var(--gap-gap-16) var(--gap-gap-16);
    background: linear-gradient(
      to bottom,
      var(--overlay-scrim-start) 0%,
      var(--overlay-scrim-mid) 45%,
      var(--overlay-scrim-end) 100%
    );
  }
  .actions .btn {
    flex: 1 1 0;
    min-width: 0;
    height: 44px;
    padding: var(--gap-gap-12) var(--gap-gap-16);
    font-size: var(--font-size-body-m);
  }

  /* Touch compact: card estrecha, botones apilados */
  @container (max-width: 200px) {
    .rtp-chip {
      top: var(--gap-gap-8);
      right: var(--gap-gap-8);
    }
    .actions {
      flex-direction: column;
      gap: var(--gap-gap-8);
      padding: var(--gap-gap-16) var(--gap-gap-8) var(--gap-gap-8);
    }
    .actions .btn {
      flex: none;
      width: 100%;
      padding: var(--gap-gap-12);
      font-size: var(--font-size-body-m);
    }
  }

  /* Pointer: giro 3D. El hover va en .card-pt (que no gira) para que no se
     pierda a mitad del giro; :focus-within lo activa también con teclado. */
  @media (hover: hover) and (pointer: fine) {
    .card-pt {
      perspective: 800px;
    }
    .rtp-chip {
      display: none;
    }
    .flip {
      position: absolute;
      inset: 0;
      transform-style: preserve-3d;
      transition: transform var(--dur-flip) ease;
    }
    .card-pt:is(:hover, :focus-within) .flip {
      transform: rotateY(180deg);
    }
    .face {
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
    }
    .back {
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--gap-gap-24);
      padding: 0 var(--gap-gap-24);
      border: var(--border-br-1) solid var(--opacity-white-opc-25);
      border-radius: var(--radius-rd-md);
      transform: rotateY(180deg);
    }
    .card-pt:focus-within .back {
      border-color: var(--buttons-secondary-default);
    }
    /* Portada detrás del texto, bajo negro al 80 % (Figma: opacity/black/opc-80) */
    .back-cover {
      display: block;
      z-index: -2;
    }
    .back::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background: var(--opacity-black-opc-80);
    }
    .back {
      isolation: isolate;
    }
    .info {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--gap-gap-8);
      text-align: center;
    }
    .name {
      margin: 0;
      font: var(--text-heading-m);
      text-transform: uppercase;
      color: var(--text-primary);
    }
    .stat {
      margin: 0;
      font: var(--text-body-m-semibold);
      color: var(--text-primary);
    }
    .stat-label {
      margin-right: var(--gap-gap-8);
      color: var(--text-tertiary);
    }
    .actions {
      flex-direction: column;
      gap: var(--gap-gap-12);
      width: min(230px, 100%);
      padding: 0;
      background: none;
    }
    .actions .btn {
      flex: none;
      width: 100%;
      height: 52px;
      padding: var(--gap-gap-16) var(--gap-gap-24);
      font-size: var(--font-size-body-l);
    }
  }

  /* Sin movimiento: sin giro, el reverso aparece con un fundido */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: reduce) {
    .flip,
    .card-pt:is(:hover, :focus-within) .flip {
      transform: none;
      transition: none;
    }
    .back {
      transform: none;
      opacity: 0;
      transition: opacity 120ms ease;
    }
    .card-pt:is(:hover, :focus-within) .back {
      opacity: 1;
    }
  }
</style>
