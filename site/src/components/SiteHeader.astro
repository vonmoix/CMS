---
import { withBase } from "../lib/url.js";

interface Props {
  pages: { title: string; href: string }[];
  currentPath: string;
}

const { pages, currentPath } = Astro.props as Props;
const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
---

<header class="site-header" data-nav>
  <nav class="site-nav" aria-label="Principal">
    <a class="brand" href={withBase("/")} aria-label="MoixCMS, ir a la portada">
      MoixCMS
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" data-nav-toggle>
      <span class="nav-toggle-label" data-nav-label>Menú</span>
      <span class="nav-toggle-icon" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
    <ul class="nav-links" id="nav-menu">
      {pages.map((p, i) => (
        <li style={`--i: ${i}`}>
          <a href={p.href} aria-current={normalize(p.href) === currentPath ? "page" : undefined}>
            <span class="nav-index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <span class="nav-title">{p.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  // Menú móvil: botón que despliega la lista a pantalla completa.
  const header = document.querySelector<HTMLElement>("[data-nav]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const label = document.querySelector<HTMLElement>("[data-nav-label]");
  const desktop = window.matchMedia("(min-width: 720px)");

  function setOpen(open: boolean, { returnFocus = false } = {}) {
    if (!header || !toggle) return;
    header.toggleAttribute("data-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    if (label) label.textContent = open ? "Cerrar" : "Menú";
    document.documentElement.classList.toggle("nav-locked", open);
    if (open) header.querySelector<HTMLElement>(".nav-links a")?.focus({ preventScroll: true });
    else if (returnFocus) toggle.focus();
  }

  toggle?.addEventListener("click", () => setOpen(!header?.hasAttribute("data-open")));
  header?.querySelectorAll(".nav-links a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && header?.hasAttribute("data-open")) setOpen(false, { returnFocus: true });
  });
  desktop.addEventListener("change", (e) => e.matches && setOpen(false));
</script>
