---
import { getCollection } from "astro:content";
import { withBase } from "../lib/url.js";
import "../styles/tokens.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = "", ogImage } = Astro.props as Props;

// Menú: todas las páginas publicadas, en el orden fijado desde el panel de
// administración (campo "order"; a igualdad, por título). Se genera solo,
// así que una página nueva creada desde el panel aparece en la cabecera sin
// tocar código.
const navPages = (await getCollection("pages", (p) => !p.data.draft))
  .map((p) => ({
    title: p.data.title,
    href: withBase(p.data.slug === "index" ? "/" : `/${p.data.slug}/`),
    order: p.data.order,
  }))
  .sort((a, b) => a.order - b.order || a.title.localeCompare(b.title, "es"));

const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = normalize(Astro.url.pathname);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={new URL(withBase(ogImage), Astro.site).href} />}
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@400;600;700&display=swap"
    />
    <!-- Sin JS el menú se muestra siempre; con JS se pliega en móvil. -->
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header" data-nav>
      <nav class="site-nav" aria-label="Principal">
        <a class="brand" href={withBase("/")} aria-label="MoixCMS, ir a la portada">
          MoixCMS
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" data-nav-toggle>
          <span class="nav-toggle-label" data-nav-label>Menú</span>
          <span class="nav-toggle-icon" aria-hidden="true"><span></span><span></span><span></span></span>
        </button>
        <ul class="nav-links" id="nav-menu">
          {navPages.map((p, i) => (
            <li style={`--i: ${i}`}>
              <a href={p.href} aria-current={normalize(p.href) === currentPath ? "page" : undefined}>
                <span class="nav-index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <span class="nav-title">{p.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-top">
          <p class="footer-brand">MoixCMS</p>
          <p>Sitio construido con nuestro propio CMS</p>
        </div>
        <p>© {new Date().getFullYear()} MoixCMS. Todos los derechos reservados.</p>
      </div>
    </footer>

    <script>
      // Menú móvil: botón que despliega la lista a pantalla completa.
      const header = document.querySelector<HTMLElement>("[data-nav]");
      const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
      const label = document.querySelector<HTMLElement>("[data-nav-label]");
      const desktop = window.matchMedia("(min-width: 720px)");

      function setOpen(open: boolean, { returnFocus = false } = {}) {
        if (!header || !toggle) return;
        header.toggleAttribute("data-open", open);
        toggle.setAttribute("aria-expanded", String(open));
        if (label) label.textContent = open ? "Cerrar" : "Menú";
        document.documentElement.classList.toggle("nav-locked", open);
        if (open) header.querySelector<HTMLElement>(".nav-links a")?.focus({ preventScroll: true });
        else if (returnFocus) toggle.focus();
      }

      toggle?.addEventListener("click", () => setOpen(!header?.hasAttribute("data-open")));
      header?.querySelectorAll(".nav-links a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && header?.hasAttribute("data-open")) setOpen(false, { returnFocus: true });
      });
      desktop.addEventListener("change", (e) => e.matches && setOpen(false));
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* Alias de las variables antiguas hacia los tokens de Figma (styles/tokens.css) */
    --color-bg: var(--fill-page-grey-medium);
    --color-surface: var(--fill-surface-grey-dark);
    --color-surface-2: var(--color-neutral-600);
    --color-border: var(--color-neutral-600);
    --color-text: var(--text-primary);
    --color-muted: var(--text-tertiary);
    --color-accent: var(--buttons-fill-primary-default);
    --color-accent-ink: var(--buttons-text-primary-default);

    --font-display: "Barlow Semi Condensed", ui-sans-serif, system-ui, sans-serif;
    --font-sans: var(--font-display);

    --space-xs: 4px;
    --space-sm: 8px;
    --space-md: 16px;
    --space-lg: 24px;
    --space-xl: 48px;

    --header-h: 64px;
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Tamaños de texto en móvil (modo Mobile de las variables de Figma) */
  @media (max-width: 719px) {
    :root:root {
      --font-size-heading-m: 28px;
      --line-height-heading-m: 28px;
      --font-size-heading-s: 21px;
      --line-height-heading-s: 21px;
      --font-size-body-l: 18px;
      --line-height-body-l: 24px;
      --font-size-body-s: 14px;
      --line-height-body-s: 22px;
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--color-bg);
  }

  html.nav-locked {
    overflow: hidden;
  }

  body {
    margin: 0;
    font-family: var(--font-sans);
    color: var(--color-text);
    background: var(--color-bg);
    font-size: var(--font-size-body-l);
    line-height: var(--line-height-body-l);
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  h2 {
    margin: 0 0 20px;
    font-size: var(--font-size-heading-s);
    line-height: var(--line-height-heading-s);
  }

  a {
    color: var(--color-accent);
  }

  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  main {
    max-width: var(--layout-content-6col);
    margin: 0 auto;
    padding: 0 var(--gap-gap-16);
  }

  @media (min-width: 720px) {
    main {
      padding: 0 var(--gap-gap-48);
    }
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .skip-link {
    position: absolute;
    left: var(--space-md);
    top: -100px;
    z-index: 100;
    padding: var(--space-sm) var(--space-md);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-weight: 600;
  }

  .skip-link:focus {
    top: var(--space-sm);
  }

  /* ---------- Cabecera ---------- */

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--fill-page-grey-medium);
    border-bottom: 1px solid var(--stroke-br-100);
  }

  .site-nav {
    max-width: var(--layout-content-6col);
    height: var(--header-h);
    margin: 0 auto;
    padding: 0 var(--gap-gap-16);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-gap-24);
  }

  @media (min-width: 720px) {
    .site-nav {
      padding: 0 var(--gap-gap-48);
    }
  }

  .brand {
    font-weight: 700;
    font-size: var(--font-size-heading-s);
    line-height: var(--line-height-heading-s);
    text-transform: uppercase;
    color: var(--buttons-text-primary-default);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-self: stretch;
    gap: var(--gap-gap-24);
    min-width: 0;
  }

  .nav-links li {
    display: flex;
  }

  .nav-links a {
    position: relative;
    display: flex;
    align-items: center;
    font-weight: 600;
    font-size: var(--font-size-body-l);
    line-height: var(--line-height-body-l);
    color: var(--text-tertiary);
    text-decoration: none;
    white-space: nowrap;
    transition: color 160ms var(--ease-out);
  }

  .nav-links a:hover {
    color: var(--color-text);
  }

  .nav-links a[aria-current="page"] {
    color: var(--color-text);
  }

  /* Indicador de página actual pegado al borde inferior de la cabecera */
  .nav-links a[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--color-accent);
  }

  .nav-index {
    display: none;
  }

  .nav-toggle {
    display: none;
  }

  /* ---------- Menú móvil (solo con JS; sin JS la lista se muestra entera) ---------- */

  @media (max-width: 719px) {
    .js .nav-toggle {
      display: inline-flex;
      align-items: center;
      gap: var(--space-sm);
      min-height: 44px;
      margin-right: calc(var(--space-sm) * -1);
      padding: 0 var(--space-sm);
      background: none;
      border: 0;
      color: var(--buttons-text-primary-default);
      cursor: pointer;
    }

    /* El texto Menú/Cerrar sigue disponible para lectores de pantalla; a la vista solo el icono */
    .nav-toggle-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .nav-toggle-icon {
      position: relative;
      width: 22px;
      height: 14px;
    }

    .nav-toggle-icon span {
      position: absolute;
      left: 0;
      width: 100%;
      height: 2px;
      background: currentColor;
      transition: transform 240ms var(--ease-out), opacity 160ms var(--ease-out);
    }

    .nav-toggle-icon span:nth-child(1) {
      top: 0;
    }

    .nav-toggle-icon span:nth-child(2) {
      top: 6px;
    }

    .nav-toggle-icon span:nth-child(3) {
      bottom: 0;
    }

    [data-open] .nav-toggle-icon span:nth-child(1) {
      transform: translateY(6px) rotate(45deg);
    }

    [data-open] .nav-toggle-icon span:nth-child(2) {
      opacity: 0;
    }

    [data-open] .nav-toggle-icon span:nth-child(3) {
      transform: translateY(-6px) rotate(-45deg);
    }

    /* Sin JS: los enlaces bajo la marca, en una fila que se puede deslizar */
    html:not(.js) .site-nav {
      height: auto;
      flex-wrap: wrap;
      padding-top: var(--space-md);
    }

    html:not(.js) .nav-links {
      width: 100%;
      overflow-x: auto;
      padding-bottom: var(--space-md);
    }

    .js .nav-links {
      position: fixed;
      inset: var(--header-h) 0 0 0;
      flex-direction: column;
      gap: 0;
      padding: var(--space-lg) var(--gap-gap-16) var(--space-xl);
      overflow-y: auto;
      background: var(--fill-page-grey-medium);
      visibility: hidden;
      opacity: 0;
      transition: opacity 200ms var(--ease-out), visibility 0s linear 200ms;
    }

    .js [data-open] .nav-links {
      visibility: visible;
      opacity: 1;
      transition: opacity 200ms var(--ease-out);
    }

    .js .nav-links li {
      border-bottom: 1px solid var(--color-border);
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 320ms var(--ease-out), transform 320ms var(--ease-out);
    }

    .js [data-open] .nav-links li {
      opacity: 1;
      transform: none;
      transition-delay: calc(var(--i) * 40ms + 60ms);
    }

    .js .nav-links a {
      flex: 1;
      align-items: baseline;
      gap: var(--space-md);
      padding: 18px 0;
      font-size: var(--font-size-heading-m);
      line-height: var(--line-height-heading-m);
      font-weight: 700;
      text-transform: uppercase;
      color: var(--color-text);
      white-space: normal;
    }

    .js .nav-links a[aria-current="page"] {
      color: var(--color-accent);
    }

    .js .nav-links a[aria-current="page"]::after {
      display: none;
    }

    .js .nav-index {
      display: inline;
      min-width: 2ch;
      font-size: 0.8rem;
      font-weight: 500;
      font-variant-numeric: tabular-nums;
      color: var(--color-muted);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-links,
    .nav-links li,
    .nav-toggle-icon span {
      transition: none !important;
    }
  }

  /* ---------- Pie ---------- */

  .site-footer {
    margin-top: var(--gap-gap-64);
    background: var(--fill-page-grey-medium);
    border-top: 1px solid var(--stroke-br-100);
    color: var(--text-tertiary);
    font-size: var(--font-size-body-s);
    line-height: var(--line-height-body-s);
  }

  .footer-inner {
    max-width: var(--layout-content-6col);
    margin: 0 auto;
    padding: var(--gap-gap-24) var(--gap-gap-16);
    display: flex;
    flex-direction: column;
    gap: var(--gap-gap-8);
  }

  .footer-inner p {
    margin: 0;
  }

  .footer-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-gap-8) var(--gap-gap-24);
  }

  .footer-inner .footer-brand {
    font-weight: 700;
    font-size: var(--font-size-heading-s);
    line-height: var(--line-height-heading-s);
    text-transform: uppercase;
    color: var(--text-primary);
  }

  @media (min-width: 720px) {
    .footer-inner {
      padding: var(--gap-gap-24) var(--gap-gap-48);
    }
  }

  /* Botón primario, tamaño S. .btn-l = tamaño L */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 35px;
    padding: var(--gap-gap-8) var(--gap-gap-32);
    background: var(--buttons-fill-primary-default);
    color: var(--buttons-text-primary-default);
    text-decoration: none;
    text-transform: uppercase;
    border-radius: var(--radius-rd-sm);
    font-weight: 700;
    font-size: 16px;
    line-height: normal;
    white-space: nowrap;
    transition: background-color 160ms var(--ease-out), color 160ms var(--ease-out);
  }

  .btn:hover {
    background: var(--buttons-fill-primary-hover);
    color: var(--buttons-text-primary-hover);
  }

  .btn-l {
    height: 56px;
    padding: var(--gap-gap-16) var(--gap-gap-64);
    font-size: 20px;
  }

  section.block {
    padding: var(--gap-gap-48) 0;
  }

  section.block + section.block {
    border-top: 1px solid var(--color-border);
  }
</style>
