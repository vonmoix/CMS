---
import { getCollection } from "astro:content";
import { withBase } from "../lib/url.js";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = "", ogImage } = Astro.props as Props;

// Menú: todas las páginas publicadas, en el orden fijado desde el panel de
// administración (campo "order"; a igualdad, por título). Se genera solo,
// así que una página nueva creada desde el panel aparece en la cabecera sin
// tocar código.
const navPages = (await getCollection("pages", (p) => !p.data.draft))
  .map((p) => ({
    title: p.data.title,
    href: withBase(p.data.slug === "index" ? "/" : `/${p.data.slug}/`),
    order: p.data.order,
  }))
  .sort((a, b) => a.order - b.order || a.title.localeCompare(b.title, "es"));

const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = normalize(Astro.url.pathname);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={new URL(withBase(ogImage), Astro.site).href} />}
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,500..800&family=Atkinson+Hyperlegible+Next:ital,wght@0,400;0,600;1,400&display=swap"
    />
    <!-- Sin JS el menú se muestra siempre; con JS se pliega en móvil. -->
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header" data-nav>
      <nav class="site-nav" aria-label="Principal">
        <a class="brand" href={withBase("/")} aria-label="MoixCMS, ir a la portada">
          Moix<span>CMS</span>
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" data-nav-toggle>
          <span class="nav-toggle-label" data-nav-label>Menú</span>
          <span class="nav-toggle-icon" aria-hidden="true"><span></span><span></span></span>
        </button>
        <ul class="nav-links" id="nav-menu">
          {navPages.map((p, i) => (
            <li style={`--i: ${i}`}>
              <a href={p.href} aria-current={normalize(p.href) === currentPath ? "page" : undefined}>
                <span class="nav-index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <span class="nav-title">{p.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} MoixCMS</p>
    </footer>

    <script>
      // Menú móvil: botón que despliega la lista a pantalla completa.
      const header = document.querySelector<HTMLElement>("[data-nav]");
      const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
      const label = document.querySelector<HTMLElement>("[data-nav-label]");
      const desktop = window.matchMedia("(min-width: 720px)");

      function setOpen(open: boolean, { returnFocus = false } = {}) {
        if (!header || !toggle) return;
        header.toggleAttribute("data-open", open);
        toggle.setAttribute("aria-expanded", String(open));
        if (label) label.textContent = open ? "Cerrar" : "Menú";
        document.documentElement.classList.toggle("nav-locked", open);
        if (open) header.querySelector<HTMLElement>(".nav-links a")?.focus({ preventScroll: true });
        else if (returnFocus) toggle.focus();
      }

      toggle?.addEventListener("click", () => setOpen(!header?.hasAttribute("data-open")));
      header?.querySelectorAll(".nav-links a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && header?.hasAttribute("data-open")) setOpen(false, { returnFocus: true });
      });
      desktop.addEventListener("change", (e) => e.matches && setOpen(false));
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* Neutros tintados hacia el azul marino de las ilustraciones (hue 265) */
    --color-bg: oklch(0.17 0.025 265);
    --color-surface: oklch(0.21 0.03 265);
    --color-surface-2: oklch(0.25 0.035 265);
    --color-border: oklch(0.31 0.03 265);
    --color-text: oklch(0.94 0.012 265);
    --color-muted: oklch(0.73 0.03 265);
    /* Acento "señal de instrumento": se usa poco, a propósito */
    --color-accent: oklch(0.82 0.14 75);
    --color-accent-ink: oklch(0.2 0.04 75);

    --font-display: "Archivo", ui-sans-serif, system-ui, sans-serif;
    --font-sans: "Atkinson Hyperlegible Next", ui-sans-serif, system-ui, sans-serif;

    --space-xs: 4px;
    --space-sm: 8px;
    --space-md: 16px;
    --space-lg: 24px;
    --space-xl: 48px;

    --header-h: 64px;
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--color-bg);
  }

  html.nav-locked {
    overflow: hidden;
  }

  body {
    margin: 0;
    font-family: var(--font-sans);
    color: var(--color-text);
    background: var(--color-bg);
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-stretch: 108%;
    line-height: 1.12;
    letter-spacing: -0.015em;
  }

  a {
    color: var(--color-accent);
  }

  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .skip-link {
    position: absolute;
    left: var(--space-md);
    top: -100px;
    z-index: 100;
    padding: var(--space-sm) var(--space-md);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-weight: 600;
  }

  .skip-link:focus {
    top: var(--space-sm);
  }

  /* ---------- Cabecera ---------- */

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .site-nav {
    max-width: 1100px;
    height: var(--header-h);
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .brand {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  .brand span {
    font-weight: 500;
    color: var(--color-muted);
  }

  .nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-self: stretch;
    gap: var(--space-lg);
    min-width: 0;
  }

  .nav-links li {
    display: flex;
  }

  .nav-links a {
    position: relative;
    display: flex;
    align-items: center;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--color-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 160ms var(--ease-out);
  }

  .nav-links a:hover {
    color: var(--color-text);
  }

  .nav-links a[aria-current="page"] {
    color: var(--color-text);
  }

  /* Indicador de página actual pegado al borde inferior de la cabecera */
  .nav-links a[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--color-accent);
  }

  .nav-index {
    display: none;
  }

  .nav-toggle {
    display: none;
  }

  /* ---------- Menú móvil (solo con JS; sin JS la lista se muestra entera) ---------- */

  @media (max-width: 719px) {
    .js .nav-toggle {
      display: inline-flex;
      align-items: center;
      gap: var(--space-sm);
      min-height: 44px;
      margin-right: calc(var(--space-sm) * -1);
      padding: 0 var(--space-sm);
      background: none;
      border: 0;
      color: var(--color-text);
      font: 500 0.95rem var(--font-display);
      cursor: pointer;
    }

    .nav-toggle-icon {
      position: relative;
      width: 18px;
      height: 10px;
    }

    .nav-toggle-icon span {
      position: absolute;
      left: 0;
      width: 100%;
      height: 1.5px;
      background: currentColor;
      transition: transform 240ms var(--ease-out);
    }

    .nav-toggle-icon span:first-child {
      top: 0;
    }

    .nav-toggle-icon span:last-child {
      bottom: 0;
    }

    [data-open] .nav-toggle-icon span:first-child {
      transform: translateY(4.25px) rotate(45deg);
    }

    [data-open] .nav-toggle-icon span:last-child {
      transform: translateY(-4.25px) rotate(-45deg);
    }

    /* Sin JS: los enlaces bajo la marca, en una fila que se puede deslizar */
    html:not(.js) .site-nav {
      height: auto;
      flex-wrap: wrap;
      padding-top: var(--space-md);
    }

    html:not(.js) .nav-links {
      width: 100%;
      overflow-x: auto;
      padding-bottom: var(--space-md);
    }

    .js .nav-links {
      position: fixed;
      inset: var(--header-h) 0 0 0;
      flex-direction: column;
      gap: 0;
      padding: var(--space-lg) 1.5rem var(--space-xl);
      overflow-y: auto;
      background: var(--color-bg);
      visibility: hidden;
      opacity: 0;
      transition: opacity 200ms var(--ease-out), visibility 0s linear 200ms;
    }

    .js [data-open] .nav-links {
      visibility: visible;
      opacity: 1;
      transition: opacity 200ms var(--ease-out);
    }

    .js .nav-links li {
      border-bottom: 1px solid var(--color-border);
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 320ms var(--ease-out), transform 320ms var(--ease-out);
    }

    .js [data-open] .nav-links li {
      opacity: 1;
      transform: none;
      transition-delay: calc(var(--i) * 40ms + 60ms);
    }

    .js .nav-links a {
      flex: 1;
      align-items: baseline;
      gap: var(--space-md);
      padding: 18px 0;
      font-size: 1.6rem;
      font-weight: 600;
      font-stretch: 108%;
      color: var(--color-text);
      white-space: normal;
    }

    .js .nav-links a[aria-current="page"] {
      color: var(--color-accent);
    }

    .js .nav-links a[aria-current="page"]::after {
      display: none;
    }

    .js .nav-index {
      display: inline;
      min-width: 2ch;
      font-size: 0.8rem;
      font-weight: 500;
      font-variant-numeric: tabular-nums;
      color: var(--color-muted);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-links,
    .nav-links li,
    .nav-toggle-icon span {
      transition: none !important;
    }
  }

  /* ---------- Pie ---------- */

  .site-footer {
    margin-top: 4rem;
    padding: 2rem 1.5rem;
    border-top: 1px solid var(--color-border);
    text-align: center;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .btn {
    display: inline-block;
    padding: 0.7rem 1.3rem;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    text-decoration: none;
    border-radius: 6px;
    font-family: var(--font-display);
    font-weight: 600;
    transition: background-color 160ms var(--ease-out);
  }

  .btn:hover {
    background: oklch(0.87 0.12 75);
  }

  section.block {
    padding: 3rem 0;
  }

  section.block + section.block {
    border-top: 1px solid var(--color-border);
  }
</style>
