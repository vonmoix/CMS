<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Páginas — Panel de contenido</title>
  <link rel="stylesheet" href="/admin.css" />
</head>
<body>
  <header class="topbar">
    <strong>Panel de contenido</strong>
    <div class="topbar-right">
      <span class="muted">Conectado como <%= editorName %></span>
      <form method="post" action="/logout"><button class="link-btn" type="submit">Salir</button></form>
    </div>
  </header>

  <main class="container">
    <div class="page-header">
      <h1>Páginas</h1>
      <a class="btn" href="/pages/new">+ Nueva página</a>
    </div>

    <% if (flash) { %>
      <p class="banner"><%= flash %></p>
    <% } %>

    <% if (!pages.length) { %>
      <p class="muted">Todavía no hay páginas. Crea la primera con "Nueva página".</p>
    <% } %>

    <table class="table">
      <thead>
        <tr>
          <th>Orden</th>
          <th>Título</th>
          <th>Slug</th>
          <th>Estado</th>
          <th>Última edición</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% pages.forEach(function(p, i) { %>
          <tr>
            <td class="order-controls">
              <form method="post" action="/pages/<%= p.slug %>/move" style="display:inline">
                <input type="hidden" name="direction" value="up" />
                <button class="icon-btn" type="submit" title="Subir en el menú" <%= i === 0 ? 'disabled' : '' %>>↑</button>
              </form>
              <form method="post" action="/pages/<%= p.slug %>/move" style="display:inline">
                <input type="hidden" name="direction" value="down" />
                <button class="icon-btn" type="submit" title="Bajar en el menú" <%= i === pages.length - 1 ? 'disabled' : '' %>>↓</button>
              </form>
            </td>
            <td>
              <% if (!p.data) { %>
                (error al leer)
              <% } else if (p.data.draft) { %>
                <a href="/pages/<%= p.slug %>/edit" title="Borrador: todavía no está publicada"><%= p.data.title %></a>
              <% } else { %>
                <a href="<%= publicUrl(p.slug) %>" target="_blank" rel="noopener" title="Ver la página publicada"><%= p.data.title %> <span aria-hidden="true">↗</span></a>
              <% } %>
            </td>
            <td><code><%= p.slug %></code></td>
            <td>
              <% if (p.data && p.data.draft) { %>
                <span class="badge">Borrador</span>
              <% } else { %>
                <span class="badge badge-live">Publicada</span>
              <% } %>
            </td>
            <td class="muted">
              <%= p.data && p.data.updatedAt ? new Date(p.data.updatedAt).toLocaleString('es-ES') : '—' %>
              <% if (p.data && p.data.updatedBy) { %> · <%= p.data.updatedBy %><% } %>
            </td>
            <td>
              <div class="row-actions">
                <a class="icon-btn" href="/pages/<%= p.slug %>/edit" title="Editar" aria-label="Editar <%= p.slug %>">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                </a>
                <% if (p.slug !== 'index') { %>
                  <form method="post" action="/pages/<%= p.slug %>/delete" onsubmit="return confirm('¿Eliminar la página &quot;' + '<%= p.slug %>' + '&quot;? Esta acción no se puede deshacer.');" style="display:inline">
                    <button class="icon-btn danger" type="submit" title="Eliminar" aria-label="Eliminar <%= p.slug %>">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                    </button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <p class="muted">El orden fijado aquí es el que se usa para los enlaces de la cabecera y el menú móvil del sitio.</p>
  </main>
</body>
</html>
