# Copia este archivo a ".env" y completa los valores.

# Puerto en el que arranca el panel
PORT=3000

# Contraseña compartida del equipo de marketing para entrar al panel.
# (cada persona introduce su nombre + esta contraseña; el nombre se usa
# para firmar los commits y para mostrar quién editó cada página)
ADMIN_PASSWORD=cambia-esto

# Clave usada para firmar la cookie de sesión. Poné cualquier cadena larga
# y aleatoria (ej: openssl rand -hex 32)
SESSION_SECRET=cambia-esto-tambien

# --- GitHub ---
# Token de acceso con permiso de escritura sobre "Contents" del repo.
# Recomendado: un GitHub App o un fine-grained personal access token con
# permiso "Contents: Read and write" limitado a este único repositorio.
GITHUB_TOKEN=

# Usuario/organización y nombre del repositorio donde vive el sitio
GITHUB_OWNER=tu-usuario-u-organizacion
GITHUB_REPO=tu-repo

# Rama sobre la que se hacen los commits de contenido
GITHUB_BRANCH=main

# Rutas dentro del repo (relativas a la raíz), deben coincidir con la
# estructura del proyecto "site/"
CONTENT_PATH=site/src/content/pages
IMAGES_PATH=site/public/images

# Cómo referencia el sitio publicado a las imágenes de site/public/images
# (normalmente "/images", salvo que cambiéis "base" en astro.config.mjs)
PUBLIC_IMAGES_BASE=/images

# URL pública del sitio publicado (para los enlaces "ver página" del panel)
PUBLIC_SITE_URL=https://vonmoix.github.io/CMS
